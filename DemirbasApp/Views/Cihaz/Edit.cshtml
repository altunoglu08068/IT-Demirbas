@model DemirbasApp.Models.Cihaz
<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="form-group">
        <label asp-for="Marka"></label>
        <input asp-for="Marka" class="form-control" />
        <span asp-validation-for="Marka" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Model"></label>
        <input asp-for="Model" class="form-control" />
        <span asp-validation-for="Model" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="SeriNo"></label>
        <input asp-for="SeriNo" class="form-control" />
        <span asp-validation-for="SeriNo" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="AlimTarihi"></label>
        <input asp-for="AlimTarihi" type="date" class="form-control" />
        <span asp-validation-for="AlimTarihi" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Durum"></label>
        <select asp-for="Durum" class="form-control">
            <option value="">Seçiniz</option>
            <option value="Aktif">Aktif</option>
            <option value="Arızalı">Arızalı</option>
            <option value="Depoda">Depoda</option>
        </select>
        <span asp-validation-for="Durum" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Güncelle</button>
</form>